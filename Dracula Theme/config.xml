
<?xml version="1.0" encoding="UTF-8" ?>
<NotepadPlus>
    <GUIConfigs>
        <GUIConfig name="ToolBar" visible="yes">small</GUIConfig>
        <GUIConfig name="StatusBar">show</GUIConfig>
        <GUIConfig name="TabBar" dragAndDrop="yes" drawTopBar="yes"
            drawInactiveTab="yes" reduce="no" closeButton="yes"
            doubleClick2Close="yes" vertical="no"
            multiLine="no" hide="no" />
        <GUIConfig name="ScintillaViewsSplitter" />
        <GUIConfig name="UserDefineDlg" position="undocked" />
        <GUIConfig name="TabSetting" size="12" />
        <GUIConfig name="DockingManager" leftWidth="200"
            rightWidth="200" bottomHeight="150" />
        <GUIConfig name="DarkMode" enable="yes" />
        <GUIConfig name="Auto-detection" enabled="yes" />
        <GUIConfig name="DocumentSwitcher" enable="yes" />
    </GUIConfigs>

    <FindHistory nbMaxFindHistoryPath="10"
        nbMaxFindHistoryFilter="10"
        nbMaxFindHistoryFind="20"
        nbMaxFindHistoryReplace="20" />

    <ProjectPanels>
        <ProjectPanel id="0" workSpaceFile="" />
        <ProjectPanel id="1" workSpaceFile="" />
        <ProjectPanel id="2" workSpaceFile="" />
    </ProjectPanels>

    <ScintillaViews>
        <View lineNumberMargin="show"
              bookmarkMargin="show"
              indentGuide="show"
              currentLineHilitingShow="yes"
              wrap="yes"
              edge="no"
              eol="no"
              whiteSpaceShow="no"
              zoom="0"
              lineWrapMethod="aligned"
              smoothFont="yes"
              fontQuality="3" />
    </ScintillaViews>

    <EditorConfig>
        <AutoIndentation indent="4" />
        <AutoCompletion enabled="yes" />
        <FunctionParametersHint enabled="yes" />
        <SmartHighlighting enabled="yes" />
    </EditorConfig>

    <GUIConfigs>
        <GUIConfig name="RememberLastSession">yes</GUIConfig>
        <GUIConfig name="MaitainIndent">yes</GUIConfig>
        <GUIConfig name="Backup">yes</GUIConfig>
    </GUIConfigs>
</NotepadPlus>
